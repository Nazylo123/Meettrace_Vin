# ---- LLM provider selection -------------------------------------------------
# LLM_PROVIDER selects which provider the API route uses.
#   "openrouter" (default): cloud, requires OPENROUTER_API_KEY.
#   "ollama"             : local, requires Ollama running on OLLAMA_BASE_URL.
LLM_PROVIDER=openrouter

# ---- OpenRouter (cloud) -----------------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the default model. Default: qwen/qwen-2.5-7b-instruct
# (good balance of speed + quality + cost for structured extraction).
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
# Optional: override the base URL (for self-hosted OpenRouter-compatible APIs).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: attribution headers for the OpenRouter dashboard.
# OPENROUTER_REFERER=https://meettrace.local
# OPENROUTER_TITLE=MeetTrace

# ---- Ollama (local) ---------------------------------------------------------
# Only used when LLM_PROVIDER=ollama. The local path is fully offline.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# ---- Shared limits ----------------------------------------------------------
# Hard cap on transcript size (characters) accepted by /api/analyze.
MEETTRACE_MAX_CHARS=60000
# Per-request timeout in milliseconds.
MEETTRACE_TIMEOUT_MS=120000
